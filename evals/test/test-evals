  def test_recommendation_needs_enough_valid_trials
    g = [{ "task_id" => "t", "model" => "a", "effort" => "low", "valid_trials" => 1, "pass_rate" => 1.0, "critical_misses" => 0,
           "median_repair_loops" => 0, "cost_per_success_usd" => 0.01 },
         { "task_id" => "t", "model" => "b", "effort" => "low", "valid_trials" => 1, "pass_rate" => 1.0, "critical_misses" => 0,
           "median_repair_loops" => 0, "cost_per_success_usd" => 0.02 }]
    assert_match(/insufficient evidence/, Evals::Summary.recommend(g, candidate: "a@low", reference: "b@low", task_id: "t"))
    g.each { |x| x["valid_trials"] = 3 }
    # Three trials on one task clear the per-task bar but stay preliminary.
    rec = Evals::Summary.recommend(g, candidate: "a@low", reference: "b@low", task_id: "t")
    assert_match(/\Apreliminary: .*3 valid samples over 1 distinct task/, rec)
    refute_match(/consider promotion/, rec)
  end

  def test_promotion_needs_nine_samples_over_three_tasks_per_model_effort_and_role
    row = lambda do |task, model, effort, family: task, n: 3|
      { "task_id" => task, "task_family" => family, "role" => "wf-reviewer", "host" => "h", "model" => model, "effort" => effort,
        "valid_trials" => n, "pass_rate" => 1.0, "critical_misses" => 0, "median_repair_loops" => 0,
        "cost_per_success_usd" => model == "a" ? 0.01 : 0.02 }
    end
    rec = ->(g) { Evals::Summary.recommend(g, candidate: "a@medium", reference: "b@medium", task_id: "t1") }
    three = %w[t1 t2 t3].flat_map { |t| [row.call(t, "a", "medium"), row.call(t, "b", "medium")] }
    assert_match(/consider promotion \(recommendation only\)/, rec.call(three))
    # Nine samples on one task are not three tasks.
    assert_match(/\Apreliminary/, rec.call([row.call("t1", "a", "medium", n: 9), row.call("t1", "b", "medium", n: 9)]))
    # A defect task and its control share a family and count once.
    paired = [row.call("t1", "a", "medium"), row.call("t2", "a", "medium", family: "pair"), row.call("t3", "a", "medium", family: "pair"),
              row.call("t1", "b", "medium")]
    assert_match(/\Apreliminary: .*9 valid samples over 2 distinct task/, rec.call(paired))
    # High-effort runs never count toward medium.
    mixed = [row.call("t1", "a", "medium"), row.call("t2", "a", "medium"), row.call("t3", "a", "high"), row.call("t1", "b", "medium")]
    assert_match(/\Apreliminary: .*6 valid samples over 2 distinct task/, rec.call(mixed))
    ready = Evals::Summary.promotion_readiness(three).find { |x| x["model"] == "a" }
    assert_equal ["meets the sample minimum", 9, 3], ready.values_at("status", "valid_samples", "distinct_tasks")
  end

  def test_source_state_ignores_the_harness_results_tree_and_nothing_else
    Dir.mktmpdir do |repo|
      system("git", "-C", repo, "init", "-q")
      FileUtils.mkdir_p(File.join(repo, "evals", "results", "2026-01-01"))
      File.write(File.join(repo, "tracked.txt"), "a")
      system({ "GIT_AUTHOR_NAME" => "t", "GIT_AUTHOR_EMAIL" => "t@example.invalid", "GIT_COMMITTER_NAME" => "t", "GIT_COMMITTER_EMAIL" => "t@example.invalid" },
             "git", "-C", repo, "-c", "commit.gpgsign=false", "add", "-A")
      system({ "GIT_AUTHOR_NAME" => "t", "GIT_AUTHOR_EMAIL" => "t@example.invalid", "GIT_COMMITTER_NAME" => "t", "GIT_COMMITTER_EMAIL" => "t@example.invalid" },
             "git", "-C", repo, "-c", "commit.gpgsign=false", "commit", "-q", "-m", "base")
      ENV["EVAL_REPO_SCRATCH"] = repo
      task = Evals::Task.new("scratch", repo, { "repo" => "scratch" })
      before = Evals.source_state(task)
      File.write(File.join(repo, "evals", "results", "2026-01-01", "record.json"), "{}")
      assert_equal before, Evals.source_state(task), "a new run record must not read as a source change"
      File.write(File.join(repo, "tracked.txt"), "b")
      refute_equal before, Evals.source_state(task), "a real source change must still be seen"
    end
  ensure
    ENV.delete("EVAL_REPO_SCRATCH")
  end

  def test_cost_breakdown_keeps_preparation_execution_verification_and_repair_apart
    task = Evals.load_task("example-review")
    rec = { "cost" => { "usd" => 0.07, "status" => "api_equivalent_estimate" }, "tokens" => { "input" => 10 }, "wall_seconds" => 40.0,
            "timing" => { "delegate_seconds" => 31.5, "grading_seconds" => 0.2 }, "grader" => { "findings" => 4, "unclassified_findings" => 1 },
            "repair_loops" => { "harness" => 0, "agent_failed_tool_results" => 2 } }
    b = Evals.cost_breakdown(rec, task, packet: task.packet_text, final: "x" * 400)
    assert_equal %w[preparation delegate_execution host_verification repair], b.keys
    assert_equal %w[reusable_eval_setup per_task_delegation], b["preparation"].keys
    assert_equal 4, b.dig("preparation", "per_task_delegation", "packet", "requirement_items")
    assert_equal "not_recorded", b.dig("preparation", "reusable_eval_setup", "status")
    assert_equal [0.07, 31.5, "delegate process only"], b["delegate_execution"].values_at("usd", "wall_seconds", "wall_basis")
    assert_equal [0.0, 100, 4, 1], [b.dig("host_verification", "usd"), b.dig("host_verification", "reply", "est_tokens"),
                                   b.dig("host_verification", "findings_to_read"), b.dig("host_verification", "findings_needing_adjudication")]
    assert_equal [0, 2], b["repair"].values_at("harness_loops", "delegate_internal_failed_tool_results")
    old = Evals.cost_breakdown(rec.reject { |k, _| k == "timing" }, task, packet: "p", final: "")
    assert_match(/whole trial/, old.dig("delegate_execution", "wall_basis"))
    assert_equal "not_recorded", old.dig("preparation", "reusable_eval_setup", "status")
  end

