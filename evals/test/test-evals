#!/usr/bin/env ruby
# frozen_string_literal: true

# Deterministic tests for the eval harness. No model calls. They run on the
# built-in example task and need no evidence store.

require "minitest/autorun"
require "open3"
require_relative "../lib/verify"

class EvalHarnessTest < Minitest::Test
  RUN = File.expand_path("../bin/run", __dir__)

  def test_every_harness_verification_check_passes
    failed = Evals::Verify.checks.reject(&:pass)
    assert_empty failed.map { |c| "#{c.area}: #{c.name} [#{c.detail}]" }
  end

  def run_cli(*args) = Open3.capture3(RbConfig.ruby, RUN, *args)

  def test_refuses_efforts_outside_v0
    %w[xhigh max ultra].each do |e|
      _, err, st = run_cli("--task", "example-review", "--host", "codex", "--model", "gpt-5.6-terra", "--effort", e)
      assert_equal 2, st.exitstatus, e
      assert_match(/outside v0/, err)
    end
  end

  def test_refuses_listed_but_inaccessible_codex_model
    skip "no Codex account catalog" unless File.exist?(File.join(Dir.home, ".codex", "models_cache.json"))
    cache = JSON.parse(File.read(File.join(Dir.home, ".codex", "models_cache.json")))
