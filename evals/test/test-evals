      spec_record(a, "fam-v2-a", version: 2, behaviour: "proceed_unsafe", outcome: "fail")
      spec_record(File.join(root, "unlisted"), "fam-v2-a", version: 2, behaviour: "stop_recognized")
      manifest = { "name" => "m", "trials" => 3, "configs" => [{ "task" => "fam-v2-a", "host" => "claude-code", "model" => "m", "effort" => "medium" }],
                   "tasks_meta" => { "fam-v2-a" => { "experiment" => "spec-sensitivity", "experiment_version" => 2 } }, "run_dirs" => [a] }
      path = File.join(root, "manifest.json")
      File.write(path, JSON.generate(manifest))
      results = Evals.results_dir
      before = Dir.exist?(results) ? Dir.glob(File.join(results, "*.{json,jsonl}")).to_h { |f| [f, File.mtime(f)] } : {}
      out, err, st = Open3.capture3(RbConfig.ruby, summarize, "--manifest", path)
      assert st.success?, err
      assert_match(/spec-sensitivity\s+2\s+A\s+claude-code\s+m\s+medium\s+1\s+0.0 proceed_unsafe=1/, out)
      refute_match(/stop_recognized/, out, "the unlisted run is not read")
      assert_match(/Nothing written/, out)
      after = Dir.exist?(results) ? Dir.glob(File.join(results, "*.{json,jsonl}")).to_h { |f| [f, File.mtime(f)] } : {}
      assert_equal before, after, "no summary.json or local_eval_evidence.jsonl is written or touched"
      File.write(path, JSON.generate(manifest.merge("tasks_meta" => { "fam-v2-a" => { "experiment" => "spec-sensitivity", "experiment_version" => 1 } })))
      _, err, st = Open3.capture3(RbConfig.ruby, summarize, "--manifest", path)
      refute st.success?
      assert_match(/not this manifest's run set/, err)
      _, err, st = Open3.capture3(RbConfig.ruby, File.expand_path("../analysis/compare.rb", __dir__), path)
      refute st.success?, "compare.rb refuses the same mismatch"
      assert_match(/not this manifest's run set/, err)
    end
  end

  def test_unscoped_experiment_view_never_pools_families_or_versions
    recs = Dir.mktmpdir do |root|
      [spec_record(File.join(root, "a"), "fam1-a", family: "fam1"), spec_record(File.join(root, "b"), "fam2-a", family: "fam2"),
       spec_record(File.join(root, "c"), "fam1-v2-a", family: "fam1", version: 2, behaviour: "proceed_unsafe", outcome: "fail")]
    end
    groups, = Evals::Summary.group(recs)
    rows = Evals::Summary.sensitivity_by_task(groups)
    assert_equal [["fam1-a", nil], ["fam1-v2-a", 2], ["fam2-a", nil]], rows.map { |r| r.values_at("task_id", "experiment_version") }
    assert(rows.all? { |r| r["valid_trials"] == 1 })
    pooled = Evals::Summary.sensitivity(groups)
    assert_equal [[1, 2], [2, 1]], pooled.map { |r| r.values_at("experiment_version", "valid_trials") }, "even the pooled view keeps versions apart"
  end

  def test_summary_does_not_touch_the_registry
    src = File.read(File.expand_path("../lib/summary.rb", __dir__))
    refute_match(/models\.yaml/, src.lines.reject { |l| l.strip.start_with?("#") }.join)
  end
